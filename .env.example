# Public site origin used by canonical URLs, Schema, Open Graph, robots and sitemap.
# Keep the current URL until the purchased domain is attached and HTTPS works.
NEXT_PUBLIC_SITE_URL=https://coloringnest.vercel.app
# Optional old/alternate hostnames to redirect after the domain switch.
SITE_REDIRECT_FROM_HOSTS=
# Optional Search Console URL-prefix HTML verification code (DNS is also supported).
GOOGLE_SITE_VERIFICATION=

# Database (Supabase PostgreSQL)
DATABASE_URL=

# Supabase Storage (server-side only — NEVER expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CraftColoring Admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Google Gemini AI Studio (free-tier available; server-side only)
GEMINI_API_KEY=
GEMINI_SEO_MODEL=gemini-3.8-flash
